# BasicOAuthFlow

main: kit: flow: BasicOAuthFlow:
{
  entity: "o_auth",
  kind: "basic",
  name: "BasicOAuthFlow",
  step: [
    {
      i: {
        ref: "o_auth_ref01"
      }

      o: "create"
    }

    {
      i: {
        ref: "o_auth_ref01",
        srcdatavar: "o_auth_ref01_data",
        suffix: "_dt0"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-o_auth_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicOAuthFlow"
}