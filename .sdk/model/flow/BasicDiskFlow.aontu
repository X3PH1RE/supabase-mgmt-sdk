# BasicDiskFlow

main: kit: flow: BasicDiskFlow:
{
  entity: "disk",
  kind: "basic",
  name: "BasicDiskFlow",
  step: [
    {
      i: {
        ref: "disk_ref01",
        srcdatavar: "disk_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "disk01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-disk_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicDiskFlow"
}