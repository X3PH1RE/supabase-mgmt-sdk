# BasicStreamableFileFlow

main: kit: flow: BasicStreamableFileFlow:
{
  entity: "streamable_file",
  kind: "basic",
  name: "BasicStreamableFileFlow",
  step: [
    {
      i: {
        ref: "streamable_file_ref01",
        srcdatavar: "streamable_file_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "streamable_file01",
        project_id: "project01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-streamable_file_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicStreamableFileFlow"
}