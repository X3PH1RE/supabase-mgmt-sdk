# BasicSecretFlow

main: kit: flow: BasicSecretFlow:
{
  entity: "secret",
  kind: "basic",
  name: "BasicSecretFlow",
  step: [
    {
      i: {
        ref: "secret_ref01"
      }

      m: {
        ref: "secret_ref01"
      }

      o: "create"
    }

    {
      m: {
        ref: "ref01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "secret_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "secret_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "secret01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        ref: "ref01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "secret_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSecretFlow"
}