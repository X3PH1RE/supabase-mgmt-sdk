# BasicEnvironmentFlow

main: kit: flow: BasicEnvironmentFlow:
{
  entity: "environment",
  kind: "basic",
  name: "BasicEnvironmentFlow",
  step: [
    {
      i: {
        ref: "environment_ref01",
        srcdatavar: "environment_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "environment01",
        project_id: "project01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-environment_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicEnvironmentFlow"
}