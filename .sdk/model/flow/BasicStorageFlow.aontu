# BasicStorageFlow

main: kit: flow: BasicStorageFlow:
{
  entity: "storage",
  kind: "basic",
  name: "BasicStorageFlow",
  step: [
    {
      i: {
        ref: "storage_ref01",
        srcdatavar: "storage_ref01_data",
        suffix: "_up0",
        textfield: "migrationVersion"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-storage_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "storage_ref01",
        srcdatavar: "storage_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "storage01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-storage_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicStorageFlow"
}