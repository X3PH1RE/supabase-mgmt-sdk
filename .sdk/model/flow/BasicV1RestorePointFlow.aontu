# BasicV1RestorePointFlow

main: kit: flow: BasicV1RestorePointFlow:
{
  entity: "v1_restore_point",
  kind: "basic",
  name: "BasicV1RestorePointFlow",
  step: [
    {
      i: {
        ref: "v1_restore_point_ref01"
      }

      m: {
        project_id: "project01"
      }

      o: "create"
    }

    {
      i: {
        ref: "v1_restore_point_ref01",
        srcdatavar: "v1_restore_point_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "v1_restore_point01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-v1_restore_point_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicV1RestorePointFlow"
}