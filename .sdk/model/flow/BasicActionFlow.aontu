# BasicActionFlow

main: kit: flow: BasicActionFlow:
{
  entity: "action",
  kind: "basic",
  name: "BasicActionFlow",
  step: [
    {
      d: {
        project_id: "project01"
      }

      i: {
        ref: "action_ref01",
        srcdatavar: "action_ref01_data",
        suffix: "_up0",
        textfield: "branch_id"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-action_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "action_ref01",
        srcdatavar: "action_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "action01",
        project_id: "project01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-action_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicActionFlow"
}