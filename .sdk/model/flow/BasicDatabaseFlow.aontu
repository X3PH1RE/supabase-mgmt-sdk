# BasicDatabaseFlow

main: kit: flow: BasicDatabaseFlow:
{
  entity: "database",
  kind: "basic",
  name: "BasicDatabaseFlow",
  step: [
    {
      i: {
        ref: "database_ref01"
      }

      m: {
        project_id: "project01"
      }

      o: "create"
    }

    {
      m: {
        project_id: "project01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "database_ref01"
          }
        }
      ]
    }

    {
      d: {
        project_id: "project01"
      }

      i: {
        ref: "database_ref01",
        srcdatavar: "database_ref01_data",
        suffix: "_up0",
        textfield: "database_identifier"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-database_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "database_ref01",
        srcdatavar: "database_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "database01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-database_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "database_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "database01",
        project_id: "project01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        project_id: "project01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "database_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicDatabaseFlow"
}