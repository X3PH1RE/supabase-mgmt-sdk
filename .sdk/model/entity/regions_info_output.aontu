            version: 2
          }
          g: {
            query: [
              {
                ex: "NA"
                k: "query"
                n: "continent"
                or: "continent"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "desired_instance_size"
                or: "desired_instance_size"
