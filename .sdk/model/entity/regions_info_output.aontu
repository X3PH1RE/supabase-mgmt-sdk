                t: "`$STRING`"
              }
              {
                ex: "tsrqponmlkjihgfedcba"
                k: "query"
                n: "organization_slug"
                or: "organization_slug"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/v1/projects/available-regions"
          q: {
            exist: [
              "continent"
              "desired_instance_size"
              "organization_slug"
            ]
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "projects"
            }
            {
              lit: "available-regions"
            }
          ]
          t: {
            req: "`reqdata`"
