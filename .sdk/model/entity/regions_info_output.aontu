# Entity: regions_info_output

main: kit: entity: regions_info_output: {

  alias: field: {}

  fields: {
    all: {
      h: "All"
      n: "all"
      r: true
      t: "`$OBJECT`"
    }
    recommendations: {
      h: "Recommendations"
      n: "recommendations"
      r: true
      t: "`$OBJECT`"
    }
  }

  name: "regions_info_output"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /v1/projects/available-regions"
