  name: "auth"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /v1/projects/{ref}/config/auth"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "abcdefghijklmnopqrst"
                k: "param"
                n: "project_id"
                or: "ref"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/v1/projects/{ref}/config/auth"
          q: {
            exist: [
              "project_id"
            ]
          }
          r: {
            param: {
              ref: "project_id"
            }
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "projects"
            }
            {
              var: "project_id"
            }
            {
              lit: "config"
            }
            {
              lit: "auth"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          co: {
            id: "PATCH /v1/projects/{ref}/config/auth"
